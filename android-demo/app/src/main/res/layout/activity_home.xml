<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Type your shelf"
                android:textSize="28sp" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:text="Type one book on each line, in the order they sit on the shelf. Write the title, then the word “by”, then the author."
                android:textColor="@color/text_mut" />

            <EditText
                android:id="@+id/shelfInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_bg"
                android:gravity="top|start"
                android:hint="The Hobbit by J.R.R. Tolkien\nHoles by Louis Sachar\nMatilda by Roald Dahl"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="200dp"
                android:padding="14dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/errorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/rust" />

                <TextView
                    android:id="@+id/errorText"
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/rust"
                    android:textSize="17sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sortButton"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Sort my shelf"
                app:icon="@drawable/ic_sort" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sampleButton"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Fill in a sample shelf"
                app:icon="@drawable/ic_list" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tips"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="• Add (checked out) at the end of a line if the library says that book is out.\n• Add a call number like this:  Title | Author | 598.2"
                android:textColor="@color/text_mut"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
